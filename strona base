<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Listy</title>

<style>
body {
  margin: 0;
  font-family: 'Courier New', monospace;
  background: #f5f1e8;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

/* KOPERTA */
#envelope {
  width: 300px;
  height: 200px;
  background: #e0d4c3;
  position: relative;
  cursor: pointer;
}

#flap {
  width: 0;
  height: 0;
  border-left: 150px solid transparent;
  border-right: 150px solid transparent;
  border-bottom: 100px solid #d6c7b2;
  position: absolute;
  top: -100px;
  left: 0;
  transform-origin: bottom;
  transition: transform 1s;
}

.open #flap {
  transform: rotateX(180deg);
}

/* LIST */
#letter {
  display: none;
  position: absolute;
  top: 20px;
  left: 20px;
  right: 20px;
  bottom: 20px;
  background: #fffaf3;
  padding: 20px;
  overflow-y: auto;
}

.open #letter {
  display: block;
}

.typing {
  white-space: pre-line;
}

/* LISTA LISTÓW */
#lettersList {
  position: fixed;
  bottom: 20px;
  left: 20px;
}

button {
  margin-top: 5px;
}
</style>
</head>

<body>

<div id="envelope">
  <div id="flap"></div>
  <div id="letter">
    <div id="text" class="typing"></div>
    <div id="attachments"></div>
  </div>
</div>

<div id="lettersList"></div>

<script>
const letters = [
  {
    title: "List 1",
    content: "Cześć,\nTo jest Twój pierwszy list.\nPisany powoli, litera po literze...",
    files: [
      { name: "plik.txt", url: "plik.txt" }
    ]
  }
];

const envelope = document.getElementById('envelope');
const textEl = document.getElementById('text');
const attachmentsEl = document.getElementById('attachments');
const listEl = document.getElementById('lettersList');

let currentLetter = 0;

function typeText(text, i = 0) {
  if (i < text.length) {
    textEl.innerHTML += text.charAt(i);
    setTimeout(() => typeText(text, i + 1), 40);
  }
}

function loadLetter(index) {
  textEl.innerHTML = '';
  attachmentsEl.innerHTML = '';

  const letter = letters[index];
  typeText(letter.content);

  letter.files.forEach(file => {
    const link = document.createElement('a');
    link.href = file.url;
    link.innerText = "Pobierz: " + file.name;
    link.download = file.name;
    attachmentsEl.appendChild(link);
    attachmentsEl.appendChild(document.createElement('br'));
  });
}

envelope.addEventListener('click', () => {
  envelope.classList.add('open');
  loadLetter(currentLetter);
});

function renderList() {
  letters.forEach((l, i) => {
    const btn = document.createElement('button');
    btn.innerText = l.title;
    btn.onclick = () => {
      currentLetter = i;
      envelope.classList.add('open');
      loadLetter(i);
    };
    listEl.appendChild(btn);
  });
}

renderList();
</script>

</body>
</html>